@using Bib_Hacienda.Clases
@{
    ViewData["Title"] = "🥛 Vender producto derivado";
    var potreros = ViewBag.Potreros as List<Potrero> ?? new List<Potrero>();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="aw-page-header mb-4">
                <h1 class="display-6 fw-bold mb-1" style="color: var(--aw-text);">🥛 Vender producto derivado</h1>
                <p class="text-muted mb-0">SC-1 · Lácteos, carne o piel, sin retirar ganado del potrero</p>
            </div>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-@ViewBag.TipoMensaje alert-dismissible fade show" role="alert">
                    <strong>@ViewBag.Mensaje</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="aw-card">
                <div class="aw-card-header">Datos de la venta</div>
                <div class="card-body p-4">
                    <form asp-action="VenderProducto" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="potreroId" class="form-label fw-bold">Potrero de origen</label>
                                <select name="potreroId" id="potreroId" class="form-select form-select-lg" required>
                                    <option value="">Seleccione…</option>
                                    @foreach (var potrero in potreros)
                                    {
                                        <option value="@potrero.Identificacion">@potrero.Identificacion</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label for="tipoProducto" class="form-label fw-bold">Producto</label>
                                <select name="tipoProducto" id="tipoProducto" class="form-select form-select-lg" required>
                                    <option value="@TipoProducto.Lacteo">Lácteo</option>
                                    <option value="@TipoProducto.Carne">Carne</option>
                                    <option value="@TipoProducto.Piel">Piel</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="cantidad" class="form-label fw-bold">Cantidad</label>
                                <input name="cantidad" id="cantidad" type="number" min="1" class="form-control form-control-lg" required />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label for="monto" class="form-label fw-bold">Monto</label>
                                <input name="monto" id="monto" type="number" min="1" class="form-control form-control-lg" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn aw-btn aw-btn-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn aw-btn aw-btn-primary">Vender</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
