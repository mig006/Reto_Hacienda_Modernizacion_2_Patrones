        <mxCell id="comp-hoja-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;overflow=visible;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="&amp;laquo;Composite &amp;middot; hoja&amp;raquo;&lt;br&gt;&lt;b&gt;ReglaResNoNula&lt;/b&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;br&gt;corta si la res es null; va primera&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;br&gt;+ Validar(res: Res): ResultadoValidacion" vertex="1">
