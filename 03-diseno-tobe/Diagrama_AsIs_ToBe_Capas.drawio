        <mxCell id="DkbYuKZBiHKNnIfZTDvD-221" parent="1" style="text;html=1;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;" value="COMPOSITE (P-05) - Validacion + Autenticacion" vertex="1">
